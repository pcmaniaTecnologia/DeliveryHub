# Firebase project configuration.
# Copy this file to .env.local and fill in the values from your Firebase project console.
# NEXT_PUBLIC variables below are exposed to the browser.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public production URL used for canonical menu links and sitemap.xml.
NEXT_PUBLIC_SITE_URL=

# Server-only Firebase Admin credentials (local/Vercel/other non-Google hosting).
# Copy values from your Firebase service account into .env.local or hosting secrets.
# Never add NEXT_PUBLIC to these names and never commit actual credentials.
# On Firebase App Hosting, keep these empty to use the backend's service account.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
